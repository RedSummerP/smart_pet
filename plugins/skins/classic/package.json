{
  "name": "@smartpet/plugin-skins-classic",
  "version": "0.1.0",
  "description": "SmartPet 内置皮肤包：橘猫 / 奶茶 / 黑猫 / 薄荷（skins capability 示例插件）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
