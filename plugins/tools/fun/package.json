{
  "name": "@smartpet/plugin-tools-fun",
  "version": "0.1.0",
  "description": "SmartPet 内置娱乐工具包：抛硬币 / 掷骰子 / 今日运势（tools capability 示例插件，AI 可直接调用）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@smartpet/core": "workspace:*",
    "@smartpet/ai": "workspace:*",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}